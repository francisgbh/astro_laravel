---
import ContactForm from '../components/ContactForm.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Contacto</title>
	</head>
	<body>
		<main>
			<p class="eyebrow">Contacto</p>
			<h1>Escríbenos</h1>
			<p class="lead">Déjanos tu nombre, email, teléfono y mensaje. Te responderemos por correo.</p>
			<ContactForm />
		</main>
	</body>
</html>

<style>
	body {
		margin: 0;
		min-height: 100vh;
		background: #f4f6f8;
		color: #1c2430;
		font-family: "Segoe UI", system-ui, sans-serif;
	}

	main {
		max-width: 32rem;
		margin: 0 auto;
		padding: 4.5rem 1.25rem 3rem;
	}

	.eyebrow {
		margin: 0 0 0.4rem;
		color: #1f4d3a;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: 2.25rem;
		line-height: 1.15;
	}

	.lead {
		margin: 0.75rem 0 1.75rem;
		color: #5c6675;
		line-height: 1.5;
	}
</style>
